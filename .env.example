# ========================================================
# AI 智能写作助手 - 环境变量配置模板 (.env.example)
# 使用说明：复制本文件为 .env 并填入您个人的真实 API 密钥
# ========================================================

# 1. 默认大模型提供商选择 (支持: DeepSeek, SiliconFlow, OpenAI, Zhipu, Moonshot, DashScope, Ollama, Custom)
DEFAULT_PROVIDER="DeepSeek (官方)"

# 2. 常用大模型 API 密钥 (按需配置一个或多个)
# DeepSeek 官方 (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=""

# 硅基流动平台 (https://cloud.siliconflow.cn/)
SILICONFLOW_API_KEY=""

# OpenAI 官方 (https://platform.openai.com/)
OPENAI_API_KEY=""

# 智谱 GLM 开放平台 (https://open.bigmodel.cn/)
ZHIPU_API_KEY=""

# 月之暗面 Kimi (https://platform.moonshot.cn/)
MOONSHOT_API_KEY=""

# 阿里百炼通义千问 (https://dashscope.console.aliyun.com/)
DASHSCOPE_API_KEY=""

# 3. 自定义中转接口 (如果使用第三方中转站 / OneAPI / NewAPI)
CUSTOM_LLM_BASE_URL="https://api.openai.com/v1"
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_MODEL="gpt-4o"
